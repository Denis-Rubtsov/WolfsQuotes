# Quadlet-юнит для rootless Podman (Bazzite/Fedora Atomic), без root и rpm-ostree.
#
# Первый запуск:
#   podman build -t localhost/vlk <папка репозитория>
#   bash deploy/import-secrets.sh <старый out/appsettings.json>   # создаёт Podman-секреты из конфига
#   mkdir -p ~/botdata ~/.config/containers/systemd
#   cp deploy/vlk.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload && systemctl --user start vlk
#   sudo loginctl enable-linger $USER   # чтобы бот жил без входа в систему
#
# Обновление: podman build -t localhost/vlk <папка> && systemctl --user restart vlk
# Сменить токен: снова import-secrets.sh (или printf %s 'новый' | podman secret create --replace <имя> -), затем restart
# Логи: journalctl --user -u vlk -f
[Unit]
Description=Vlk — Telegram-бот с цитатами
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/vlk:latest
ContainerName=vlk
# Пользователь хоста становится в контейнере пользователем app (1654), так что файлы в ~/botdata остаются твоими
UserNS=keep-id:uid=1654,gid=1654
# :z (общая метка SELinux), потому что ~/botdata используют все три бота
Volume=%h/botdata:/data:z
Environment=TZ=Europe/Moscow
Environment=QuotesFile=/data/quotes.json
Environment=SystemPromptFile=/data/systemprompt.txt
# Секреты из podman secret приходят как переменные окружения и перекрывают appsettings.json из образа
Secret=vlk-telegram-token,type=env,target=Token
Secret=vlk-ai-apikey,type=env,target=AiApikey
Secret=vlk-admin-ids,type=env,target=ADMIN_IDS
Secret=vlk-basic-url,type=env,target=BASIC_URL

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
