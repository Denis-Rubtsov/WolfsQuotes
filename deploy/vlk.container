# Quadlet-юнит для rootless Podman (Bazzite/Fedora Atomic), без root и rpm-ostree.
# Что юнит ждёт на сервере (это же должен делать деплой из CI):
#   podman secret vlk-token, vlk-aiapikey   — printf %s "$TOKEN" | podman secret create --replace vlk-token -
#   ~/.config/vlk/vlk.env                   — ADMIN_IDS=..., BASIC_URL=..., [StarsPrice=...]
#   образ ghcr.io/denis-rubtsov/wolfsquotes:latest (Image= можно подменить на :sha-<коммит>)
#
# Вручную:
#   bash deploy/import-secrets.sh <старый out/appsettings.json>   # секреты + vlk.env из старого конфига
#   mkdir -p ~/botdata ~/.config/containers/systemd
#   cp deploy/vlk.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload && systemctl --user restart vlk
#   sudo loginctl enable-linger $USER   # чтобы бот жил без входа в систему
# Логи: journalctl --user -u vlk -f
[Unit]
Description=Vlk — Telegram-бот с цитатами
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/denis-rubtsov/wolfsquotes:latest
ContainerName=vlk
# Пользователь хоста становится в контейнере пользователем app (1654), так что файлы в ~/botdata остаются твоими
UserNS=keep-id:uid=1654,gid=1654
# :z (общая метка SELinux), потому что ~/botdata используют все три бота
Volume=%h/botdata:/data:z
# Несекретное: ADMIN_IDS, BASIC_URL, StarsPrice и т.п. (QuotesFile/SystemPromptFile/TZ уже заданы в образе)
EnvironmentFile=%h/.config/vlk/vlk.env
# Секреты из podman secret приходят как переменные окружения
Secret=vlk-token,type=env,target=Token
Secret=vlk-aiapikey,type=env,target=AiApikey

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
